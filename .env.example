DATABASE_URL=postgres://user:password@localhost:5432/fantasy_league
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
FOOTBALL_DATA_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_DATA_API_KEY=
# Optional: set to "offline" to replay the recorded API responses in src/workers/__fixtures__/
# (captured once via `npm run record:fixtures`) instead of calling the real API.
FOOTBALL_DATA_PROVIDER=
# Optional: only read by `npm run hydrate:initial-pricing`. Defaults to
# FOOTBALL_DATA_SEASON_YEAR - 1 — set only to override which previous season's stats the
# pre-season pricing hydration pulls.
PREVIOUS_SEASON_YEAR=
# Secret used to HMAC-sign session tokens (SignedTokenAuthProvider). Use a long random string.
AUTH_TOKEN_SECRET=
# "cognito" = real credential check against the AWS Cognito user pool — the standard mode,
# local dev included (requires the two COGNITO_* values below). Unset = passwordless HMAC
# signed-token fallback for offline work; "stub" = forgeable tokens for scripts/tests only.
AUTH_PROVIDER=cognito
# Required when AUTH_PROVIDER=cognito. Pool id looks like <region>_<id>, e.g. us-east-1_AbCdEfGhI.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Frontend switch for the handle+email+password Cognito login (bundled into client JS — pool and
# client ids are public by design). Usually the same two values as above; leave empty to fall
# back to the passwordless dev login.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=