DATABASE_URL=postgres://user:password@localhost:5432/fantasy_league
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
FOOTBALL_DATA_API_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_DATA_API_KEY=
# Optional: set to "offline" to replay the recorded API responses in src/workers/__fixtures__/
# (captured once via `npm run record:fixtures`) instead of calling the real API.
FOOTBALL_DATA_PROVIDER=
# Secret used to HMAC-sign session tokens (SignedTokenAuthProvider). Use a long random string.
AUTH_TOKEN_SECRET=
# Optional: "stub" = forgeable stub.<userId> tokens for local scripts/tests only;
# "cognito" = real credential check against an AWS Cognito user pool (deployed envs — requires
# the two COGNITO_* values below); unset = default HMAC signed-token provider for local dev.
AUTH_PROVIDER=
# Required only when AUTH_PROVIDER=cognito. Pool id looks like <region>_<id>, e.g. eu-west-2_AbCdEfGhI.
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
# Frontend switch for the email+password Cognito login (bundled into client JS — pool/client ids
# are public by design). Set both (usually to the same two values as above) to build the frontend
# in Cognito mode; leave empty for the local passwordless dev login.
NEXT_PUBLIC_COGNITO_USER_POOL_ID=
NEXT_PUBLIC_COGNITO_APP_CLIENT_ID=