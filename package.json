{
  "name": "fantasy-league",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev:api": "tsx src/api/index.ts",
    "dev:worker": "tsx src/workers/index.ts",
    "dev:worker:price-update": "tsx src/workers/monthlyPriceUpdateIndex.ts",
    "dev:web": "next dev -p 3000",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:mock": "tsx src/db/seedMock.ts",
    "seed:match-stats": "tsx src/db/seedMatchStats.ts",
    "hydrate:roster": "tsx src/workers/hydratePlayerRosterOnce.ts",
    "record:fixtures": "tsx src/workers/recordProviderFixturesOnce.ts",
    "dev:stop": "lsof -ti tcp:3000,3001 | xargs kill -9"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.162",
    "@types/node": "^26.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^5.5.4",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "amazon-cognito-identity-js": "^6.3.18",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "next": "^16.2.9",
    "pg": "^8.22.0",
    "playwright": "^1.61.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
